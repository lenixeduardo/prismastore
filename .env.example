# PrismaStore — ambiente local
PORT=4173
HOST=0.0.0.0
WHATSAPP_AUTO_CONNECT=true
PRISMASTORE_DEMO_DATA=false

# Segurança de homologação do WhatsApp.
# Quando true, somente o telefone abaixo pode disparar o chatbot ou receber mensagens.
# Informe DDD + número; o runtime acrescenta 55 automaticamente para números BR com 10/11 dígitos.
PRISMASTORE_DEV_WHATSAPP_ONLY=false
PRISMASTORE_DEV_WHATSAPP_PHONE=

# Pix local — sem gateway e sem mensalidade.
# PIX_KEY pode ser telefone, e-mail, CPF/CNPJ ou chave aleatória.
PIX_KEY=
PIX_RECIPIENT_NAME=PRISMA STORE
PIX_RECIPIENT_CITY=SAO PAULO
PIX_ACCOUNT_ID=pix-local
