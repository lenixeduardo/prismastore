# PrismaStore — ambiente local
PORT=4173
HOST=0.0.0.0
WHATSAPP_AUTO_CONNECT=true
PRISMASTORE_DEMO_DATA=false

# Admin do painel.
# Em produção PRISMASTORE_ADMIN_PASSWORD é obrigatória.
PRISMASTORE_ADMIN_USER=admin
PRISMASTORE_ADMIN_PASSWORD=
PRISMASTORE_SESSION_HOURS=12
# Use true somente quando o painel estiver atrás de HTTPS.
PRISMASTORE_AUTH_SECURE_COOKIE=false

# Segurança de homologação do WhatsApp.
# Quando true, somente o telefone abaixo pode disparar o chatbot ou receber mensagens.
# Informe DDD + número; o runtime acrescenta 55 automaticamente para números BR com 10/11 dígitos.
PRISMASTORE_DEV_WHATSAPP_ONLY=false
PRISMASTORE_DEV_WHATSAPP_PHONE=

# Pix local — sem gateway e sem mensalidade.
# PIX_KEY pode ser telefone, e-mail, CPF/CNPJ ou chave aleatória.
PIX_KEY=2d03d745-5b05-4829-833d-60e4a210a664
PIX_RECIPIENT_NAME=OSCAR FILIPE SILVA DOS SANTOS
PIX_RECIPIENT_CITY=SAO PAULO
PIX_ACCOUNT_ID=pix-local

# Backup externo no Google Drive.
# Crie credenciais OAuth para uma conta Google autorizada e guarde os valores somente no .env da VM.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
# Opcional: ID de uma pasta já criada no Drive. Em branco, PrismaStore cria/localiza "PrismaStore Backups".
GOOGLE_DRIVE_FOLDER_ID=
# Frequência do backup automático quando o Drive está configurado.
PRISMASTORE_BACKUP_INTERVAL_HOURS=24
