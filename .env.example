# PrismaStore — ambiente local
PORT=4173
HOST=0.0.0.0
WHATSAPP_AUTO_CONNECT=true
PRISMASTORE_DEMO_DATA=false

# Asaas Sandbox (use a chave criada em https://sandbox.asaas.com/)
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=

# Gere um token aleatório de 32 a 255 caracteres e use o mesmo valor
# na configuração do webhook do Asaas (header asaas-access-token).
ASAAS_WEBHOOK_TOKEN=

# O webhook deve apontar para uma URL HTTPS pública que encaminhe para:
# POST /api/webhooks/asaas
# Exemplo: https://pagamentos.seudominio.com/api/webhooks/asaas
PUBLIC_BASE_URL=
